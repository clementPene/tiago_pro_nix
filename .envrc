# The devshell is NOT loaded through direnv on purpose: with `use flake .`,
# direnv's DIRENV_DIFF (compressed snapshot of the ~330 KB devshell env) reached
# 141 KB, above Linux's 128 KiB per-variable limit (MAX_ARG_STRLEN), and every
# exec in the shell then failed with "Argument list too long".
# Enter the devshell explicitly with `nix develop` instead.
# (Do not put `use flake .` back without shrinking wsconf.json's package lists.)

export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
export CYCLONEDDS_URI=/home/cpene/Documents/tiago_pro_nix/src/agimus-demos/agimus_demos_common/config/tiago_pro/cyclone_config.xml
export ROS_DOMAIN_ID=2
